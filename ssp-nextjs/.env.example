# Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# Backend API URL (our existing FastAPI backend on Render)
NEXT_PUBLIC_API_URL=https://svadista-backend.onrender.com/api

# Google Analytics 4 Measurement ID (optional but recommended)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Stripe publishable key — required for the checkout card fields to mount.
# NEXT_PUBLIC_ vars are baked in at BUILD time, so after adding/changing this
# in Vercel you must trigger a new deployment (redeploy), not just save it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Base URL — used by the SEO validator script
BASE_URL=http://localhost:3000
