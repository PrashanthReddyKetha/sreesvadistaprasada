# Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.
# NEXT_PUBLIC_ vars are baked in at BUILD time: after adding or changing one in
# Vercel you must redeploy, not just save it.

# Backend API origin (no trailing /api). Defaults to the Render URL if unset.
NEXT_PUBLIC_BACKEND_URL=https://svadista-backend.onrender.com

# Stripe publishable key — required for the card fields on checkout and Dabba Wala.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Google sign-in (OAuth client ID). Must match GOOGLE_CLIENT_ID on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Firebase (phone number verification)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
